{
  "name": "swing-configurator",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:app:dev": "vite build --mode development",
    "build:app:prod": "vite build --mode production",
    "deploy:prod": "node ./config/deploy/deploy.js --mode=production",
    "deploy:dev": "node ./config/deploy/deploy.js --mode=development",
    "lint": "eslint src calculation && steiger ./src",
    "lint:fsd": "steiger ./src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "import:data": "node tools/door-importer/index.js"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-devtools": "^5.101.4",
    "axios": "^1.12.2",
    "cad-blueprint": "0.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockview-react": "^4.11.0",
    "immer": "^10.2.0",
    "konva": "^10.0.0",
    "lucide-react": "^1.25.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-intersection-observer": "^11.0.0",
    "react-konva": "^19.0.0",
    "recharts": "3.8.0",
    "reselect": "^5.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.11",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.0",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "steiger": "^0.6.0",
    "typescript": "~6",
    "typescript-eslint": "^8.46.0",
    "vite": "^8",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^3.2.7"
  }
}
